# Copy to .env and fill in. Never commit .env.
# Real-provider API keys go here (added when the live data layer is built), e.g.:
# TWELVEDATA_API_KEY=
# MASSIVE_API_KEY=

# Override config.providers without editing config.js:
# PROVIDER_CRYPTO=mock
# PROVIDER_US=mock

# Dev only: shift the clock to preview other market states (e.g. 53 = two days ahead).
# DEV_CLOCK_OFFSET_HOURS=0
